generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  CP
  INVESTOR
  ADMIN
}

enum PartnerStatus {
  PENDING
  VERIFIED
  TERRITORY_LOCKED
}

enum AskStatus {
  OPEN
  PLATFORM_REVERTED
  MATCHED
}

enum SubmissionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum VisitStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum LeadStage {
  NEW
  CONTACTED
  FOLLOW_UP
  VISIT_SCHEDULED
  HOT
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

model User {
  id           Int           @id @default(autoincrement())
  role         Role
  name         String
  phone        String        @unique
  email        String?       @unique
  passwordHash String
  firm         String?
  territory    String?
  budget       String?
  interest     String?
  status       PartnerStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?

  asks              Ask[]             @relation("InvestorAsks")
  askReplies        AskReply[]
  creativeRequests  CreativeRequest[]
  coordinatedVisits Visit[]           @relation("VisitCoordinator")
  assignedLeads     Lead[]            @relation("LeadAssignee")

  @@map("users")
}

model Ask {
  id         Int        @id @default(autoincrement())
  investor   User       @relation("InvestorAsks", fields: [investorId], references: [id], onDelete: Cascade)
  investorId Int
  budget     String
  type       String
  locations  String
  urgency    String
  note       String     @db.Text
  status     AskStatus  @default(OPEN)
  createdAt  DateTime   @default(now())
  deletedAt  DateTime?
  replies    AskReply[]

  @@index([investorId])
  @@map("asks")
}

model AskReply {
  id        Int      @id @default(autoincrement())
  ask       Ask      @relation(fields: [askId], references: [id], onDelete: Cascade)
  askId     Int
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId  Int?
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@index([askId])
  @@map("ask_replies")
}

model CreativeRequest {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  title     String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("creative_requests")
}

model SellerSubmission {
  id             Int              @id @default(autoincrement())
  name           String
  phone          String
  propertyDetail String
  expectedPrice  String?
  status         SubmissionStatus @default(PENDING_REVIEW)
  createdAt      DateTime         @default(now())
  deletedAt      DateTime?

  @@map("seller_submissions")
}

model Lead {
  id         Int       @id @default(autoincrement())
  name       String
  phone      String?
  email      String?
  source     String
  note       String?   @db.Text
  stage      LeadStage @default(NEW)
  assignee   User?     @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId Int?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([assigneeId])
  @@map("leads")
}

// --- Content: deals, mandates, locations, blog, testimonials, creatives ---
// Descriptive/categorical fields (city, type, status, mandateType, maturity,
// creative type/status) are kept as plain strings rather than enums so
// admins can introduce a new category from the CRUD UI without a schema
// migration.

model Deal {
  id                 Int       @id @default(autoincrement())
  slug               String    @unique
  title              String
  subtitle           String
  city               String
  cityLabel          String
  microLocation      String
  type               String
  purpose            Json // string[]
  status             String
  badges             Json // string[]
  price              Int
  priceMax           Int?
  pricePerUnit       Int
  unit               String
  benchmarkPerUnit   Int
  sizes              Json // string[]
  areaLabel          String
  facing             String?
  roadWidth          String?
  possession         String
  approval           String
  score              Int
  upsideNote         String
  highlights         Json // string[]
  whyStandsOut       Json // string[]
  locationAdvantages Json // { label, value }[]
  demandDrivers      Json // string[]
  suitsWho           Json // string[]
  overview           String    @db.Text
  bookingAmount      Int?
  featured           Boolean   @default(false)
  hot                Boolean   @default(false)
  investorPick       Boolean   @default(false)
  newListing         Boolean   @default(false)
  mapX               Int
  mapY               Int
  hue                Int
  faqs               Json // { q, a }[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  mandate   Mandate?
  creatives Creative[]

  @@map("deals")
}

model Mandate {
  id           Int      @id @default(autoincrement())
  deal         Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId       Int      @unique
  commission   String
  mandateType  String
  validity     String
  investorNote String   @db.Text
  urgent       Boolean  @default(false)
  kit          Json // string[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("mandates")
}

model LocationZone {
  id           Int       @id @default(autoincrement())
  slug         String    @unique
  name         String
  tagline      String
  overview     String    @db.Text
  maturity     String
  growthScore  Int
  priceBand    String
  avgPerSqYd   String
  idealBuyer   Json // string[]
  whyBuy       Json // string[]
  connectivity Json // { label, value }[]
  trend        Json // number[]
  mapX         Int
  mapY         Int
  hue          Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@map("location_zones")
}

model Post {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  title     String
  category  String
  excerpt   String    @db.Text
  date      DateTime
  readMins  Int
  body      Json // string[] of paragraphs
  published Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("posts")
}

model Testimonial {
  id        Int       @id @default(autoincrement())
  quote     String    @db.Text
  name      String
  context   String
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@map("testimonials")
}

model Creative {
  id        Int       @id @default(autoincrement())
  title     String
  type      String
  deal      Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId    Int?
  status    String
  hue       Int
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([dealId])
  @@map("creatives")
}

model Visit {
  id            Int         @id @default(autoincrement())
  customerName  String
  customerPhone String
  dealSlugs     Json // string[]
  preferredDate DateTime
  status        VisitStatus @default(REQUESTED)
  coordinator   User?       @relation("VisitCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)
  coordinatorId Int?
  feedback      String?     @db.Text
  createdAt     DateTime    @default(now())
  deletedAt     DateTime?

  @@index([coordinatorId])
  @@map("visits")
}
