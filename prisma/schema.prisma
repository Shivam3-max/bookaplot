generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  CP
  INVESTOR
  ADMIN
}

enum PartnerStatus {
  PENDING
  VERIFIED
  TERRITORY_LOCKED
}

enum AskStatus {
  OPEN
  PLATFORM_REVERTED
  MATCHED
}

enum SubmissionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum VisitStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum LeadStage {
  NEW
  CONTACTED
  FOLLOW_UP
  VISIT_SCHEDULED
  HOT
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

model User {
  id           Int           @id @default(autoincrement())
  role         Role
  name         String
  phone        String        @unique
  email        String?       @unique
  passwordHash String
  firm         String?
  territory    String?
  budget       String?
  interest     String?
  status       PartnerStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?
  updatedById  Int? // which admin last changed this account's status/territory
  updatedBy    User?         @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  asks              Ask[]             @relation("InvestorAsks")
  askReplies        AskReply[]
  creativeRequests  CreativeRequest[]
  coordinatedVisits Visit[]           @relation("VisitCoordinator")
  assignedLeads     Lead[]            @relation("LeadAssignee")
  updatedUsers      User[]            @relation("UserUpdatedBy")

  // Audit-trail back-relations - who created/updated/deleted each row.
  createdDeals             Deal[]             @relation("DealCreatedBy")
  updatedDeals             Deal[]             @relation("DealUpdatedBy")
  deletedDeals             Deal[]             @relation("DealDeletedBy")
  createdMandates          Mandate[]          @relation("MandateCreatedBy")
  updatedMandates          Mandate[]          @relation("MandateUpdatedBy")
  createdLocationZones     LocationZone[]     @relation("LocationZoneCreatedBy")
  updatedLocationZones     LocationZone[]     @relation("LocationZoneUpdatedBy")
  deletedLocationZones     LocationZone[]     @relation("LocationZoneDeletedBy")
  createdPosts             Post[]             @relation("PostCreatedBy")
  updatedPosts             Post[]             @relation("PostUpdatedBy")
  deletedPosts             Post[]             @relation("PostDeletedBy")
  createdTestimonials      Testimonial[]      @relation("TestimonialCreatedBy")
  deletedTestimonials      Testimonial[]      @relation("TestimonialDeletedBy")
  createdCreatives         Creative[]         @relation("CreativeCreatedBy")
  deletedCreatives         Creative[]         @relation("CreativeDeletedBy")
  updatedVisits            Visit[]            @relation("VisitUpdatedBy")
  deletedVisits            Visit[]            @relation("VisitDeletedBy")
  updatedSellerSubmissions SellerSubmission[] @relation("SellerSubmissionUpdatedBy")
  deletedSellerSubmissions SellerSubmission[] @relation("SellerSubmissionDeletedBy")
  updatedLeads             Lead[]             @relation("LeadUpdatedBy")
  deletedLeads             Lead[]             @relation("LeadDeletedBy")

  @@map("users")
}

model Ask {
  id         Int        @id @default(autoincrement())
  investor   User       @relation("InvestorAsks", fields: [investorId], references: [id], onDelete: Cascade)
  investorId Int
  budget     String
  type       String
  locations  String
  urgency    String
  note       String     @db.Text
  status     AskStatus  @default(OPEN)
  createdAt  DateTime   @default(now())
  deletedAt  DateTime?
  replies    AskReply[]

  @@index([investorId])
  @@map("asks")
}

model AskReply {
  id        Int      @id @default(autoincrement())
  ask       Ask      @relation(fields: [askId], references: [id], onDelete: Cascade)
  askId     Int
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId  Int?
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@index([askId])
  @@map("ask_replies")
}

model CreativeRequest {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  title     String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("creative_requests")
}

model SellerSubmission {
  id             Int              @id @default(autoincrement())
  name           String
  phone          String
  propertyDetail String
  expectedPrice  String?
  status         SubmissionStatus @default(PENDING_REVIEW)
  createdAt      DateTime         @default(now())
  deletedAt      DateTime?
  updatedById    Int?
  updatedBy      User?            @relation("SellerSubmissionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById    Int?
  deletedBy      User?            @relation("SellerSubmissionDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@map("seller_submissions")
}

model Lead {
  id          Int       @id @default(autoincrement())
  name        String
  phone       String?
  email       String?
  source      String
  note        String?   @db.Text
  stage       LeadStage @default(NEW)
  assignee    User?     @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId  Int?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  updatedById Int?
  updatedBy   User?     @relation("LeadUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById Int?
  deletedBy   User?     @relation("LeadDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([assigneeId])
  @@map("leads")
}

// --- Content: deals, mandates, locations, blog, testimonials, creatives ---
// Descriptive/categorical fields (city, type, status, mandateType, maturity,
// creative type/status) are kept as plain strings rather than enums so
// admins can introduce a new category from the CRUD UI without a schema
// migration.
//
// createdBy/updatedBy/deletedBy track which admin performed each action,
// alongside the existing createdAt/updatedAt/deletedAt timestamps.

model Deal {
  id                 Int       @id @default(autoincrement())
  slug               String    @unique
  title              String
  subtitle           String
  city               String
  cityLabel          String
  microLocation      String
  type               String
  purpose            Json // string[]
  status             String
  badges             Json // string[]
  price              Int
  priceMax           Int?
  pricePerUnit       Int
  unit               String
  benchmarkPerUnit   Int
  sizes              Json // string[]
  areaLabel          String
  facing             String?
  roadWidth          String?
  possession         String
  approval           String
  score              Int
  upsideNote         String
  highlights         Json // string[]
  whyStandsOut       Json // string[]
  locationAdvantages Json // { label, value }[]
  demandDrivers      Json // string[]
  suitsWho           Json // string[]
  overview           String    @db.Text
  bookingAmount      Int?
  featured           Boolean   @default(false)
  hot                Boolean   @default(false)
  investorPick       Boolean   @default(false)
  newListing         Boolean   @default(false)
  mapX               Int
  mapY               Int
  hue                Int
  faqs               Json // { q, a }[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  createdById        Int?
  createdBy          User?     @relation("DealCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById        Int?
  updatedBy          User?     @relation("DealUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById        Int?
  deletedBy          User?     @relation("DealDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  mandate   Mandate?
  creatives Creative[]

  @@map("deals")
}

model Mandate {
  id           Int      @id @default(autoincrement())
  deal         Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId       Int      @unique
  commission   String
  mandateType  String
  validity     String
  investorNote String   @db.Text
  urgent       Boolean  @default(false)
  kit          Json // string[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  Int?
  createdBy    User?    @relation("MandateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById  Int?
  updatedBy    User?    @relation("MandateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("mandates")
}

model LocationZone {
  id           Int       @id @default(autoincrement())
  slug         String    @unique
  name         String
  tagline      String
  overview     String    @db.Text
  maturity     String
  growthScore  Int
  priceBand    String
  avgPerSqYd   String
  idealBuyer   Json // string[]
  whyBuy       Json // string[]
  connectivity Json // { label, value }[]
  trend        Json // number[]
  mapX         Int
  mapY         Int
  hue          Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdById  Int?
  createdBy    User?     @relation("LocationZoneCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById  Int?
  updatedBy    User?     @relation("LocationZoneUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById  Int?
  deletedBy    User?     @relation("LocationZoneDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@map("location_zones")
}

model Post {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  title       String
  category    String
  excerpt     String    @db.Text
  date        DateTime
  readMins    Int
  body        Json // string[] of paragraphs
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById Int?
  createdBy   User?     @relation("PostCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById Int?
  updatedBy   User?     @relation("PostUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById Int?
  deletedBy   User?     @relation("PostDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@map("posts")
}

model Testimonial {
  id          Int       @id @default(autoincrement())
  quote       String    @db.Text
  name        String
  context     String
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  createdById Int?
  createdBy   User?     @relation("TestimonialCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deletedById Int?
  deletedBy   User?     @relation("TestimonialDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@map("testimonials")
}

model Creative {
  id          Int       @id @default(autoincrement())
  title       String
  type        String
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId      Int?
  status      String
  hue         Int
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  createdById Int?
  createdBy   User?     @relation("CreativeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deletedById Int?
  deletedBy   User?     @relation("CreativeDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([dealId])
  @@map("creatives")
}

model Visit {
  id            Int         @id @default(autoincrement())
  customerName  String
  customerPhone String
  dealSlugs     Json // string[]
  preferredDate DateTime
  status        VisitStatus @default(REQUESTED)
  coordinator   User?       @relation("VisitCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)
  coordinatorId Int?
  feedback      String?     @db.Text
  createdAt     DateTime    @default(now())
  deletedAt     DateTime?
  updatedById   Int?
  updatedBy     User?       @relation("VisitUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById   Int?
  deletedBy     User?       @relation("VisitDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([coordinatorId])
  @@map("visits")
}
